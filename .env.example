# Fill the DeepSeek key, then run with LLM_PROVIDER=deepseek.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional NVIDIA fallback: set LLM_PROVIDER=nvidia to use it.
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3

# Optional Gmail invoice intake.
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_MAILBOX=Invoice Review Queue
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
